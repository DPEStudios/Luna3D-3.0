* text=auto

# Código y texto: siempre LF en repo y en disco
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
*.xml  text eol=lf
*.csv  text eol=lf
*.sql  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Scripts Windows: CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binarios: no tocar jamás
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.otf  binary
*.ttf  binary
*.woff binary
*.woff2 binary
